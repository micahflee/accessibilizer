        "page-7-r0001"
      ],
      "text": "UNITS",
      "type": "heading"
    },
    {
      "id": "page-7-s0002",
      "page": 7,
      "source_regions": [
        "page-7-r0005"
      ],
      "text": "I (current)",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0003",
      "normalized_math": "[A] = C/s",
      "page": 7,
      "source_regions": [
        "page-7-r0002"
      ],
      "spoken_math_alternative": "The unit ampere equals coulombs per second.",
      "type": "formula"
    },
    {
      "id": "page-7-s0004",
      "page": 7,
      "source_regions": [
        "page-7-r0008"
      ],
      "text": "V (potential difference)",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0005",
      "normalized_math": "[V] = J/C",
      "page": 7,
      "source_regions": [
        "page-7-r0006"
      ],
      "spoken_math_alternative": "The unit volt equals joules per coulomb.",
      "type": "formula"
    },
    {
      "id": "page-7-s0006",
      "page": 7,
      "source_regions": [
        "page-7-r0004"
      ],
      "text": "P (power)",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0007",
      "normalized_math": "[W] = J/s",
      "page": 7,
      "source_regions": [
        "page-7-r0003"
      ],
      "spoken_math_alternative": "The unit watt equals joules per second.",
      "type": "formula"
    },
    {
      "id": "page-7-s0008",
      "page": 7,
      "source_regions": [
        "page-7-r0009"
      ],
      "text": "R (resistance)",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0009",
      "normalized_math": "[\\Omega] = V/A = (V\\cdot s)/C = (J\\cdot s)/C^2",
      "page": 7,
      "source_regions": [
        "page-7-r0007"
      ],
      "spoken_math_alternative": "The unit ohm equals volts per ampere, which equals volt-seconds per coulomb, which equals joule-seconds per coulomb squared.",
      "type": "formula"
    },
    {
      "id": "page-7-s0010",
      "level": 2,
      "page": 7,
      "source_regions": [
        "page-7-r0010"
      ],
      "text": "UNITS: Watts",
      "type": "heading"
    },
    {
      "id": "page-7-s0011",
      "normalized_math": "W = AV = (C/s)(J/C) = J/s\\;\\checkmark",
      "page": 7,
      "source_regions": [
        "page-7-r0011"
      ],
      "spoken_math_alternative": "Watts equal amperes times volts, equal coulombs per second times joules per coulomb, equal joules per second. Check mark.",
      "type": "formula"
    },
    {
      "id": "page-7-s0012",
      "page": 7,
      "source_regions": [
        "page-7-r0012"
      ],
      "text": "Power can also be expressed:",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0013",
      "normalized_math": "(V = IR) \\rightarrow P = I(IR) = I^2R",
      "page": 7,
      "source_regions": [
        "page-7-r0013"
      ],
      "spoken_math_alternative": "From V equals I R, power equals I times I R, which equals I squared R.",
      "type": "formula"
    },
    {
      "id": "page-7-s0014",
      "normalized_math": "(I = V/R) \\rightarrow P = (V/R)V = V^2/R",
      "page": 7,
      "source_regions": [
        "page-7-r0014"
      ],
      "spoken_math_alternative": "From I equals V over R, power equals V over R times V, which equals V squared over R.",
      "type": "formula"
    },
    {
      "id": "page-7-s0015",
      "normalized_math": "P = IV",
      "page": 7,
      "source_regions": [
        "page-7-r0016"
      ],
      "spoken_math_alternative": "Power equals current times voltage.",
      "type": "formula"
    },
    {
      "id": "page-7-s0016",
      "normalized_math": "P = I^2R",
      "page": 7,
      "source_regions": [
        "page-7-r0017"
      ],
      "spoken_math_alternative": "Power equals current squared times resistance.",
      "type": "formula"
    },
    {
      "id": "page-7-s0017",
      "normalized_math": "P = V^2/R",
      "page": 7,
      "source_regions": [
        "page-7-r0015"
      ],
      "spoken_math_alternative": "Power equals voltage squared over resistance.",
      "type": "formula"
    },
    {
      "id": "page-7-s0018",
      "level": 1,
      "page": 7,
      "source_regions": [
        "page-7-r0018"
      ],
      "text": "Power Sources (Voltage Source)",
      "type": "heading"
    },
    {
      "id": "page-7-s0019",
      "page": 7,
      "source_regions": [
        "page-7-r0019"
      ],
      "text": "• Battery (DC) — direct current",
      "type": "paragraph"
    },
    {
      "complexity": "simple",
      "detailed_figure_description": null,
      "figure_alternative": "Voltage-versus-time graph for a battery's direct current. The vertical axis is V, the horizontal axis is t in seconds, and the line remains approximately constant at 1.5 volts.",
      "id": "page-7-s0020",
      "page": 7,
      "source_regions": [
        "page-7-r0020"
      ],
      "type": "figure"
    },
    {
      "id": "page-7-s0021",
      "page": 7,
      "source_regions": [
        "page-7-r0021"
      ],
      "text": "• Generator (AC) — alternating current",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0022",
      "level": 2,
      "page": 7,
      "source_regions": [
        "page-7-r0022"
      ],
      "text": "Advantages over DC:",
      "type": "heading"
    },
    {
      "id": "page-7-s0023",
      "page": 7,
      "source_regions": [
        "page-7-r0023"
      ],
      "text": "• Easier/safer to transmit over long distances.",
      "type": "paragraph"
    },
    {
      "id": "page-7-s0024",
      "page": 7,
      "source_regions": [
        "page-7-r0024"
      ],
      "text": "• Easy/efficient to generate.",
      "type": "paragraph"
    }
  ],
