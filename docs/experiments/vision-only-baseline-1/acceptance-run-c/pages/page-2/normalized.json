  "semantic_layer": [
    {
      "id": "page-2-s0001",
      "page": 2,
      "source_regions": [
        "page-2-r0001"
      ],
      "text": "Example: A steady current of 2.5 A is created in a wire for 1.0 minute. How much charge passed by any given point, and how many electrons would this be?",
      "type": "paragraph"
    },
    {
      "id": "page-2-s0002",
      "normalized_math": "I = \\frac{Q}{\\Delta t} \\;\\rightarrow\\; I = \\frac{2.5\\ \\mathrm{C}}{\\mathrm{s}} = \\frac{Q}{t}",
      "page": 2,
      "source_regions": [
        "page-2-r0002"
      ],
      "spoken_math_alternative": "I equals Q divided by delta t, which leads to I equals 2.5 coulombs per second, equal to Q divided by t.",
      "type": "formula"
    },
    {
      "id": "page-2-s0003",
      "normalized_math": "Q = I t = \\left(\\frac{2.5\\ \\mathrm{C}}{\\mathrm{s}}\\right)(60\\ \\mathrm{s}) = 150\\ \\mathrm{C}",
      "page": 2,
      "source_regions": [
        "page-2-r0003"
      ],
      "spoken_math_alternative": "Q equals I times t, equal to 2.5 coulombs per second times 60 seconds, equal to 150 coulombs.",
      "type": "formula"
    },
    {
      "id": "page-2-s0004",
      "page": 2,
      "source_regions": [
        "page-2-r0004"
      ],
      "text": "# of electrons:",
      "type": "paragraph"
    },
    {
      "id": "page-2-s0005",
      "normalized_math": "N = (150\\ \\mathrm{C})\\left(\\frac{1\\ e^-}{1.6\\times10^{-19}\\ \\mathrm{C}}\\right) = 9.4\\times10^{20}\\ \\text{electrons}",
      "page": 2,
      "source_regions": [
        "page-2-r0005"
      ],
      "spoken_math_alternative": "N equals 150 coulombs times one electron per 1.6 times 10 to the negative 19 coulombs, equal to 9.4 times 10 to the 20 electrons.",
      "type": "formula"
    },
    {
      "id": "page-2-s0006",
      "page": 2,
      "source_regions": [
        "page-2-r0006"
      ],
      "text": "In moles:",
      "type": "paragraph"
    },
    {
      "id": "page-2-s0007",
      "normalized_math": "n = 9.4\\times10^{20}\\ \\text{electrons}\\left(\\frac{1}{6.022\\times10^{23}\\ \\text{electrons}/\\mathrm{mol}}\\right) = 0.0016\\ \\mathrm{mol}",
      "page": 2,
      "source_regions": [
        "page-2-r0007"
      ],
      "spoken_math_alternative": "n equals 9.4 times 10 to the 20 electrons times one divided by 6.022 times 10 to the 23 electrons per mole, equal to 0.0016 mole.",
      "type": "formula"
    },
    {
      "id": "page-2-s0008",
      "level": 1,
      "page": 2,
      "source_regions": [
        "page-2-r0008"
      ],
      "text": "Electrical Resistance",
      "type": "heading"
    },
