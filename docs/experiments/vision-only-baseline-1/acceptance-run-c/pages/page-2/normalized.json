    },
    {
      "id": "page-2-s0013",
      "normalized_math": "[\\Omega] = \\left[\\frac{V}{A}\\right] = \\left[\\frac{J/C}{C/s}\\right]",
      "page": 2,
      "source_regions": [
        "page-2-r0013"
      ],
      "spoken_math_alternative": "The units of ohms equal volts per ampere, equal joules per coulomb divided by coulombs per second.",
      "type": "formula"
    },
    {
      "id": "page-2-s0014",
      "page": 2,
      "source_regions": [
        "page-2-r0014"
      ],
      "text": "A resistor resists the flow of current. They’re often used to limit current in a part of a circuit. Wires themselves have some resistance, but we’ll usually ignore it.",
      "type": "paragraph"
    }
