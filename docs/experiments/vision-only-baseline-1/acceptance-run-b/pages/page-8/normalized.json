      "normalized_math": "V_{\\mathrm{RMS}}=\\left(\\overline{V_0^2\\sin^2(\\omega t)}\\right)^{1/2}=\\left(V_0^2\\left(\\frac{1}{2}\\right)\\right)^{1/2}=\\frac{1}{\\sqrt{2}}V_0",
