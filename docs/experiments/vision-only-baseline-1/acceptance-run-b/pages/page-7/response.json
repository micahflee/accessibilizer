    },
    {
      "boxes": [
        [
          0.651,
          0.044,
          0.787,
          0.082
        ]
      ],
      "normalized_math": "[W] = J/s",
      "spoken_math_alternative": "The unit watt equals joules per second.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.51,
          0.093,
          0.674,
          0.125
        ]
      ],
      "text": "R (resistance)",
      "type": "paragraph"
    },
    {
      "boxes": [
        [
          0.66,
          0.086,
          0.866,
          0.158
        ]
      ],
      "normalized_math": "[Ω] = V/A = (V·s)/C = (J·s)/C^2",
      "spoken_math_alternative": "The unit ohm equals volts per ampere, which equals volt seconds per coulomb, which equals joule seconds per coulomb squared.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.106,
          0.194,
          0.298,
          0.228
        ]
      ],
      "level": 2,
      "text": "UNITS: Watts",
      "type": "heading"
    },
    {
      "boxes": [
        [
          0.242,
          0.214,
          0.724,
          0.264
        ]
      ],
      "normalized_math": "W = AV = (C/s)(J/C) = J/s",
      "spoken_math_alternative": "Watts equal amperes times volts, equal coulombs per second times joules per coulomb, equal joules per second.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.128,
          0.292,
          0.586,
          0.329
        ]
      ],
      "text": "Power can also be expressed:",
      "type": "paragraph"
    },
    {
      "boxes": [
        [
          0.143,
          0.338,
          0.666,
          0.382
        ]
      ],
      "normalized_math": "(V = IR) → P = I(IR) = I^2R",
      "spoken_math_alternative": "Using V equals I R, power equals I times I R, which equals I squared R.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.145,
          0.397,
          0.66,
          0.441
        ]
      ],
      "normalized_math": "(I = V/R) → P = (V/R)V = V^2/R",
      "spoken_math_alternative": "Using I equals V over R, power equals V over R times V, which equals V squared over R.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.158,
          0.451,
          0.329,
          0.516
        ]
      ],
      "normalized_math": "P = IV",
      "spoken_math_alternative": "Power equals current times voltage.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.374,
          0.453,
          0.512,
          0.512
        ]
      ],
      "normalized_math": "P = I^2R",
      "spoken_math_alternative": "Power equals current squared times resistance.",
      "type": "formula"
    },
    {
      "boxes": [
        [
          0.614,
          0.45,
          0.735,
          0.518
        ]
      ],
      "normalized_math": "P = V^2/R",
      "spoken_math_alternative": "Power equals voltage squared divided by resistance.",
      "type": "formula"
    },
    {
