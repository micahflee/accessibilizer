    },
    {
      "boxes": [
        [
          0.086,
          0.408,
          0.674,
          0.445
        ]
      ],
      "text": "Ohmic materials obey Ohm’s Law:",
      "type": "paragraph"
    },
    {
      "boxes": [
        [
          0.169,
          0.484,
          0.315,
          0.548
        ]
      ],
      "normalized_math": "I=\\frac{V}{R}",
      "spoken_math_alternative": "I equals V divided by R",
      "type": "formula"
