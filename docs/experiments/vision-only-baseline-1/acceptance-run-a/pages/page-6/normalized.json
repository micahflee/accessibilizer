      "source_regions": [
        "page-6-r0012"
      ],
      "spoken_math_alternative": "Power equals energy divided by time.",
      "type": "formula"
    },
    {
      "id": "page-6-s0010",
      "level": 2,
      "page": 6,
      "source_regions": [
        "page-6-r0014"
      ],
      "text": "Electrical energy:",
      "type": "heading"
    },
    {
      "id": "page-6-s0011",
      "normalized_math": "U=qV",
      "page": 6,
      "source_regions": [
        "page-6-r0015"
      ],
      "spoken_math_alternative": "U equals q V.",
      "type": "formula"
    },
    {
      "id": "page-6-s0012",
      "normalized_math": "P=\\frac{(\\mathrm{charge})(\\mathrm{Voltage})}{\\mathrm{time}}=IV",
      "page": 6,
      "source_regions": [
        "page-6-r0013"
      ],
      "spoken_math_alternative": "Power equals charge times voltage divided by time, which equals current times voltage.",
      "type": "formula"
    },
    {
